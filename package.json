{
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node ./scripts/generate-feeds.mjs && node ./scripts/generate-sitemap.mjs",
    "reindex": "node ./scripts/reindex-pinecone.mjs",
    "serve": "next start",
    "clean": "node ./scripts/clean.mjs",
    "lint": "eslint --max-warnings=0 \"{components,constant,layouts,libs,pages,scripts,types,utils}/**/*.{js,jsx,mjs,ts,tsx}\"",
    "lint:fix": "eslint --fix --max-warnings=0 \"{components,constant,layouts,libs,pages,scripts,types,utils}/**/*.{js,jsx,mjs,ts,tsx}\"",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:crawl": "node ./scripts/crawl-sitemap.mjs",
    "optimize:images": "node ./scripts/optimize-images.mjs",
    "perf:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=.lighthouserc.json",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e:workbench": "playwright test --config playwright.workbench.config.ts",
    "themes:generate": "node scripts/generate-workbench-themes.mjs"
  },
  "dependencies": {
    "@next/env": "^16.3.6",
    "@segment/analytics-next": "^1.84.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.1.1",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "nextjs-pinecone-search": "^0.1.1",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-preset-minify": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "smoothscroll-polyfill": "^0.4.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "globby": "^16.2.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "mdx-bundler": {
      "remark-mdx-frontmatter": "6.0.0",
      "uuid": "11.1.1"
    }
  }
}
